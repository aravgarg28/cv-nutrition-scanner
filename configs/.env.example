# SnapNutrition environment template. Copy to repo-root `.env` (gitignored) for local
# dev. Values are intentionally blank. Secrets policy: docs/security/SECRET_MANAGEMENT.md.
# Local defaults target the Docker Compose services (T-003).

# --- App ---
ENV=local
LOG_LEVEL=info

# --- Database (Postgres + pgvector) ---
# Local compose default: postgresql+asyncpg://snap:snap@localhost:5432/snap
DATABASE_URL=

# --- Object storage (S3-compatible: MinIO locally, Cloudflare R2 in beta) ---
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Auth (T-006+) ---
JWT_SIGNING_KEY=            # EdDSA private key; generate per environment, never commit
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- External data providers ---
USDA_FDC_API_KEY=          # https://fdc.nal.usda.gov/api-key-signup.html (free)
OPEN_FOOD_FACTS_USER_AGENT=snapnutrition/0.0 (contact@example.com)

# --- Assistant LLM (T-050; verify no-training-on-API-data terms — PRIVACY_MODEL) ---
LLM_PROVIDER=
LLM_API_KEY=

# --- Email (transactional; free tier — verify at pick, COST_MODEL) ---
EMAIL_PROVIDER=console      # 'console' prints links to logs in local/test
EMAIL_API_KEY=

# --- ML / experiment tracking (ML pipelines/CI only; never the API service) ---
WANDB_API_KEY=
